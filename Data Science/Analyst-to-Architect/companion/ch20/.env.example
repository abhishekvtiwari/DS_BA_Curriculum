# Copy this file to .env (never commit .env) and fill in your own values.
# The database: your user and password from Chapter 12, section 12.3.
RIVERSTONE_DB=postgresql+psycopg://postgres:your-password@localhost:5432/riverstone_full

# Testing: the local mail server from section 20.6 (no password, nothing leaves your computer).
SMTP_HOST=localhost
SMTP_PORT=8025
SMTP_USER=flash@riverstone.example
SMTP_PASSWORD=

# For real sending, use your service account instead, for example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_PASSWORD=the-service-account-password

FLASH_TO=you@riverstone.example
FLASH_FAILURE_TO=you@riverstone.example
