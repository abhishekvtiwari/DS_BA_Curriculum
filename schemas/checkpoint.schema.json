{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "track",
    "module_id",
    "status",
    "completed_artifacts",
    "open_issues",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "track": {
      "enum": [
        "DS",
        "BA"
      ]
    },
    "module_id": {
      "type": "string",
      "pattern": "^(DS|BA)-M[0-9]{2}$"
    },
    "status": {
      "enum": [
        "PLANNED",
        "OUTLINED",
        "DRAFTED",
        "PRE_ASSESSMENT_AUDITED",
        "ASSESSMENT_DRAFTED",
        "ASSESSMENT_VALIDATED",
        "FINAL_AUDITED",
        "RELEASED",
        "BLOCKED"
      ]
    },
    "completed_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
